# Required: https://app.tavily.com
TAVILY_API_KEY=

# Required: https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Required for the submission's traced demo.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tavily-ai-tutor

# Optional. Set this when one API key can access multiple LangSmith workspaces.
# LANGSMITH_WORKSPACE_ID=

# Optional. Uncomment only when your LangSmith workspace uses a regional endpoint.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
